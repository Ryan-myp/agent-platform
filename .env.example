# 供应商 API Key：实际密钥只放在本地 .env / 进程环境中，不要提交到 Git。
AGNES_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 可选：自定义模型目录路径。每个模型配置 api_key_env 引用上面的变量名。
MODEL_CATALOG_PATH=config/models.json
DATABASE_PATH=data/agent-platform.db

# 本地每日媒体生成上限（0 = 不限；单进程本地限制）
MEDIA_GENERATION_DAILY_LIMIT=0
# 视频任务本地监控期限（秒，最小 60；超时不会自动重新提交）
VIDEO_JOB_TIMEOUT_SECONDS=300
